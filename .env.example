# Names only. Real values live in Railway and Supabase settings, never in git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Email for offer codes (Resend: resend.com). EMAIL_FROM must be an address on a domain verified in Resend, e.g. Tremcore <hello@tremcore.co.uk>
EMAIL_API_KEY=
EMAIL_FROM=
# Where new-job alerts are sent
TREMCORE_ALERT_EMAIL=
# Stripe (test keys first, live keys later; server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave empty: Stripe uses the payment methods switched on in its Dashboard (Settings > Payment methods)
STRIPE_PAYMENT_METHODS=
# Tests only; leave empty in real use
STRIPE_API_BASE=
ANTHROPIC_API_KEY=
# only if your key is not tied to one workspace: the workspace ID from the Anthropic Console
ANTHROPIC_WORKSPACE_ID=
# optional: READ_MODEL=claude-sonnet-5-5
